# Existing CallLens AI settings
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_ANALYSIS_MODEL=gpt-5-nano
CALLLENS_DEMO_MODE=0

# Module 1: Auth + Tenants
# PostgreSQL production: postgresql+asyncpg://user:password@host:5432/calllens
# Local fallback: sqlite+aiosqlite:///./calllens_auth.db
DATABASE_URL=sqlite+aiosqlite:///./calllens_auth.db
DATABASE_URL_TEST=sqlite+aiosqlite:///./calllens_auth_test.db
APP_BASE_URL=http://localhost:8000
EMAIL_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@calllens.local
ALLOWED_ORIGINS=http://localhost:8000
SESSION_TTL_DAYS=30
MAGIC_LINK_TTL_MINUTES=15
INVITE_TTL_HOURS=72
